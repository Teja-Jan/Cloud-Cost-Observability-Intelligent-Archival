# Cloud Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your real credentials

# ── SendGrid Email ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.placeholder_replace_with_real_key
SENDGRID_FROM_EMAIL=noreply@yourcompany.com

# ── Cloud Platform Connections (for live integrations) ──────────────────────
# Snowflake
SF_ACCOUNT=
SF_USER=
SF_PASS=
SF_WH=
SF_DB=
SF_SCHEMA=
SF_TABLE=

# Generic Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DB_ENGINE=
DB_TABLE=

# Default connection type: snowflake | postgres | file | api
DEFAULT_CONN_TYPE=
